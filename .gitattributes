* text=auto
*.md text eol=lf
*.toml text eol=lf
*.cmake text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
# The AppImage's AppRun, desktop entry and README are read on Linux.
packaging/appimage/** text eol=lf
# Unified patches contain space-prefixed empty context lines.
*.patch text eol=lf whitespace=-blank-at-eol
patches/series text eol=lf
CMakeLists.txt text eol=lf
LICENSE text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
