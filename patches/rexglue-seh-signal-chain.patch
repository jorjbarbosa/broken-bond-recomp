@@ -21,6 +21,46 @@ namespace rex::platform {
 static thread_local SehThreadState tls_seh_state;
 static thread_local bool tls_seh_active = false;
 
+// The handlers seh_initialize replaced (for example Crashpad's, installed
+// earlier): a fault outside an SEH region reaches them with its original
+// signal information and context instead of the default action.
+static struct sigaction previous_handlers[4];
+
+static int previous_index(int sig) {
+  switch (sig) {
+    case SIGSEGV:
+      return 0;
+    case SIGBUS:
+      return 1;
+    case SIGFPE:
+      return 2;
+    case SIGILL:
+      return 3;
+    default:
+      return -1;
+  }
+}
+
+static bool has_previous(int index) {
+  return index >= 0 && previous_handlers[index].sa_handler != SIG_DFL &&
+         previous_handlers[index].sa_handler != SIG_IGN;
+}
+
+static void forward_to_previous(int sig, siginfo_t* info, void* ucontext) {
+  const int index = previous_index(sig);
+  if (!has_previous(index)) {
+    signal(sig, SIG_DFL);
+    raise(sig);
+    return;
+  }
+  const struct sigaction& previous = previous_handlers[index];
+  if (previous.sa_flags & SA_SIGINFO) {
+    previous.sa_sigaction(sig, info, ucontext);
+  } else {
+    previous.sa_handler(sig);
+  }
+}
+
 SehThreadState& seh_thread_state() {
   return tls_seh_state;
 }
