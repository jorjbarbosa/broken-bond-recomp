diff --git a/include/rex/input/input_system.h b/include/rex/input/input_system.h
index 994980a..db8703d 100644
--- a/include/rex/input/input_system.h
+++ b/include/rex/input/input_system.h
@@ -71,6 +71,19 @@ class InputSystem : public system::IInputSystem {
   // does not renumber pad two.
   std::vector<DeviceInfo> devices_;
   std::vector<InputDriver*> device_owners_;
+
+  // The packet number GetState reports per guest user, with the device packets
+  // it last saw.
+  struct DevicePacket {
+    DeviceId id = DeviceId::kInvalid;
+    uint32_t packet = 0;
+    bool operator==(const DevicePacket&) const = default;
+  };
+  struct UserPackets {
+    std::vector<DevicePacket> devices;
+    uint32_t packet = 0;
+  };
+  UserPackets user_packets_[kMaxGuestUsers];
 };
 
 /// Create a default InputSystem with SDL + NOP drivers.
diff --git a/src/input/input_system.cpp b/src/input/input_system.cpp
index d3d4dcd..610fc08 100644
--- a/src/input/input_system.cpp
+++ b/src/input/input_system.cpp
@@ -233,6 +233,7 @@ X_RESULT InputSystem::GetState(uint32_t user_index, X_INPUT_STATE* out_state) {
 
   X_INPUT_STATE merged = {};
   bool any = false;
+  std::vector<DevicePacket> packets;
   for (DeviceId id : ids) {
     auto* driver = DriverForDevice(id);
     if (!driver) {
@@ -243,6 +244,7 @@ X_RESULT InputSystem::GetState(uint32_t user_index, X_INPUT_STATE* out_state) {
       continue;
     }
     active_devices_.Observe(user_index, id, state.gamepad);
+    packets.push_back({id, static_cast<uint32_t>(state.packet_number)});
     if (!any) {
       merged = state;
       any = true;
@@ -254,6 +256,18 @@ X_RESULT InputSystem::GetState(uint32_t user_index, X_INPUT_STATE* out_state) {
   if (!any) {
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
+  // Each device counts its own packets, so the highest count stands still while
+  // a device behind it changes (a pad next to a keyboard that was used more),
+  // and the title ignores that input. The user's own count moves whenever the
+  // packet of any of its devices does.
+  if (user_index < kMaxGuestUsers) {
+    auto& user = user_packets_[user_index];
+    if (packets != user.devices) {
+      user.devices = std::move(packets);
+      ++user.packet;
+    }
+    merged.packet_number = user.packet;
+  }
   if (out_state) {
     *out_state = merged;
   }
